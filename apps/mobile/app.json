{
  "expo": {
    "name": "물때",
    "slug": "multtae",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "multtae",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "kr.multtae.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.kr.multtae.app"
        ]
      }
    },
    "android": {
      "package": "kr.multtae.app",
      "adaptiveIcon": {
        "backgroundColor": "#E4EDD3",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F6F2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#141A16",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#2F5F49"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "식물과 공간 사진을 찍어 종류와 빛을 판단합니다",
          "photosPermission": "앨범에서 고른 식물과 공간 사진으로 종류와 빛을 판단합니다",
          "microphonePermission": false
        }
      ],
      "expo-background-task",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "@bacons/apple-targets",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Today",
              "label": "물때",
              "description": "오늘 물 줄 식물을 보여 드려요",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "400dp",
              "maxResizeHeight": "300dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 3600000
            }
          ]
        }
      ],
      "./plugins/with-scene-lifecycle",
      [
        "./plugins/with-android-accent",
        {
          "light": "#2F5F49",
          "dark": "#8FC7A5"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "55170afd-2676-4d2c-b0fc-9a3a8fa907f2"
      }
    },
    "owner": "sbangiois"
  }
}
