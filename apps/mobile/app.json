{
  "expo": {
    "name": "물때",
    "slug": "multtae",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "multtae",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "kr.multtae.app"
    },
    "android": {
      "package": "kr.multtae.app",
      "adaptiveIcon": {
        "backgroundColor": "#E4EDD3",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F6F2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#141A16",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "cameraPermission": "식물과 공간 사진을 찍어 종류와 빛을 판단합니다",
          "photosPermission": "앨범에서 고른 식물과 공간 사진으로 종류와 빛을 판단합니다",
          "microphonePermission": false
        }
      ],
      "expo-background-task",
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "55170afd-2676-4d2c-b0fc-9a3a8fa907f2"
      }
    },
    "owner": "sbangiois"
  }
}
